{
    // This is the TypeScript configuration file that controls how TypeScript compiles your code
    "compilerOptions": {
        /**
         * 1. Basic Compilation Settings
         *    a. target: Specify which JavaScript version to compile to
         *    b. lib: Include ES6 library definitions
         */
        "target": "esnext",
        "lib": ["es6"],

        /**
         * 2. Module Settings
         *    a. module: Use CommonJS module system (standard for Node.js)
         *    b. rootDir: Source code root directory
         *    c. outDir: Output directory for compiled files
         */
        "module": "commonjs",
        "rootDir": "./",
        "outDir": "./dist",

        /**
         * 3. Node.js Specific Settings
         *    a. types: Include type definitions for Node.js
         *    b. Remember to run: npm install -D @types/node
         */
        "types": ["node"],

        /**
         * 4. Source Map and Declaration Settings
         *    a. sourceMap: Generate source maps for debugging
         *    b. declaration: Generate .d.ts files
         *    c. declarationMap: Generate source maps for .d.ts files
         */
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        /**
         * 5. Type Checking Settings
         *    a. strict: Enable all strict type checking options
         *    b. noUncheckedIndexedAccess: Add undefined to indexed access
         *    c. exactOptionalPropertyTypes: Be strict about optional property types
         *    d. strictPropertyInitialization: Don't require class properties to be initialized
         */
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strictPropertyInitialization": false,

        /**
         * 6. Module Interoperability
         *    a. esModuleInterop: Better interop between different module systems
         *    b. forceConsistentCasingInFileNames: Ensure consistent file name casing
         */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /**
         * 7. Decorator Support (for TypeORM and other libraries)
         *    a. emitDecoratorMetadata: Enable decorator metadata
         *    b. experimentalDecorators: Enable decorators
         */
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,

        /**
         * 8. Performance and Build
         *    a. skipLibCheck: Skip type checking of declaration files
         */
        "skipLibCheck": true,

        /**
         * 9. Optional Style Checks (commented out by default)
         *    a. noImplicitReturns: Ensure all code paths return a value
         *    b. noImplicitOverride: Ensure all overridden methods are marked with @override
         *    c. noUnusedLocals: Ensure all local variables are used
         *    d. noUnusedParameters: Ensure all function parameters are used
         *    e. noFallthroughCasesInSwitch: Ensure all switch cases are covered
         *    f. noPropertyAccessFromIndexSignature: Ensure all index signatures are used
         */
        // "noImplicitReturns": true,
        // "noImplicitOverride": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // "noFallthroughCasesInSwitch": true,
        // "noPropertyAccessFromIndexSignature": true
    },
    "include": ["src/**/*", "*.spec.ts", "tests"]
}